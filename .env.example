# ============================================================
#  Camoufox VNC - Environment Settings (Example)
# ============================================================

# Access Ports
PORT_WEB=5800       # noVNC Web UI (http://localhost:5800)
PORT_VNC=5900       # Traditional VNC client (localhost:5900)
PORT_API=9377       # HTTP Control API / MCP Server

# Virtual Screen Resolution
RESOLUTION_WIDTH=1366
RESOLUTION_HEIGHT=768

# Timezone & Locale
TZ=Europe/Lisbon

# Spoofed Operating System for Anti-Detection (windows, macos, linux)
OS_SPOOF=windows

# Initial URL when opening the browser
START_URL=https://duckduckgo.com

# Automatic Camoufox update on boot (true/false)
AUTO_UPDATE=true

# VNC Security (leave empty for passwordless access)
VNC_PASSWORD=

# Anti-Detection Behavior
ENABLE_CACHE=true

# ============================================================
#  TypeSafe Jev 1.14 Ultra-Fast Engine via OpenRouter (Optional)
# ============================================================
# Set ENABLE_JEV=true and provide OPENROUTER_API_KEY to activate
# the autonomous Ultra-Fast mode (browse_ultrafast)
ENABLE_JEV=false
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_TEXT_MODEL=openai/gpt-4o-mini


