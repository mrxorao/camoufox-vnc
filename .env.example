# ============================================================
#  Camoufox VNC - Configurações de Ambiente (Exemplo)
# ============================================================

# Portas de Acesso
PORT_WEB=5800       # Interface noVNC Web (http://localhost:5800)
PORT_VNC=5900       # Cliente VNC tradicional (localhost:5900)
PORT_API=9377       # API de Controlo HTTP / MCP Server

# Resolução do Ecrã Virtual
RESOLUTION_WIDTH=1366
RESOLUTION_HEIGHT=768

# Fuso Horário e Localização
TZ=Europe/Lisbon

# Emulação de Sistema Operativo para Anti-Deteção (windows, macos, linux)
OS_SPOOF=windows

# URL inicial ao abrir o browser
START_URL=https://duckduckgo.com

# Atualização Automática do Camoufox no arranque (true/false)
AUTO_UPDATE=true

# Segurança VNC (deixar vazio para acesso sem palavra-passe)
VNC_PASSWORD=

# Comportamento Anti-Deteção
ENABLE_CACHE=true
