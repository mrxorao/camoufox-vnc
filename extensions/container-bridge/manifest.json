{
  "manifest_version": 2,
  "name": "Camoufox Container & Proxy Bridge",
  "version": "1.4.0",
  "description": "Manage Firefox Multi-Account Containers, per-container proxies, Auto-GeoIP/GPS, data_saver and isolated cookies directly from Camoufox or MCP.",
  "browser_specific_settings": {
    "gecko": {
      "id": "container-bridge@camoufox.local",
      "strict_min_version": "91.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Camoufox Containers & Proxies",
    "default_popup": "popup.html"
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "webRequestAuthProvider",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["geo_spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
