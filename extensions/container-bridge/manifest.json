{
  "manifest_version": 2,
  "name": "Camoufox Container & Proxy Bridge",
  "version": "1.3.0",
  "description": "Internal bridge for Camoufox MCP to manage Firefox Multi-Account Containers, per-container proxies, GeoIP/timezone/locale spoofing, and isolated cookies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "container-bridge@camoufox.local",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "webRequestAuthProvider",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["geo_spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
